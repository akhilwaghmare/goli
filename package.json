{
  "name": "goli",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/website",
    "apps/desktop",
    "packages/ui"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/website dev",
    "build": "bun run --cwd apps/website build",
    "lint": "bun run --cwd apps/website lint",
    "build:service": "cd apps/local-service && go build ./cmd/goli",
    "dev:desktop": "bun run --cwd apps/desktop dev",
    "build:desktop": "bun run --cwd apps/desktop build",
    "test:desktop": "bun run --cwd apps/desktop test",
    "test:macos-tools": "bash -n apps/macos-installer/scripts/build-pkg.sh apps/macos-installer/scripts/postinstall apps/macos-installer/scripts/setup.sh apps/macos-installer/scripts/goli-maintenance apps/macos-installer/scripts/smoke-test.sh",
    "package:macos": "bun run build:desktop && bash apps/macos-installer/scripts/build-pkg.sh",
    "smoke:macos": "bash apps/macos-installer/scripts/smoke-test.sh"
  },
  "packageManager": "bun@1.3.3"
}
